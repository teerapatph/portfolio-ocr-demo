---
import '@/styles/global.css'

interface Props {
	title?: string;
}

const { title = "Demo OCR API" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="./demo-logo.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Demo OCR API" />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

